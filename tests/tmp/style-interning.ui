<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="main_window">
    <property name="title">CSS intern</property>
    <property name="default-width">1600</property>
    <property name="default-height">750</property>
    <child>
      <object class="GtkScrolledWindow" id="scroll_root">
        <property name="hexpand">true</property>
        <property name="vexpand">true</property>
        <child>
          <object class="GtkBox" id="root_box">
            <property name="orientation">vertical</property>
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <child>
              <object class="GtkBox" id="node_2">
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <property name="orientation">vertical</property>
                <property name="spacing">0</property>
                <style><class name="tw-2"/></style>
                <child>
                  <object class="GtkBox" id="repeat_one">
                    <property name="orientation">vertical</property>
                    <property name="spacing">0</property>
                    <style><class name="tw-3"/></style>
                    <child>
                      <object class="GtkLabel" id="node_4">
                        <property name="xalign">0.0</property>
                        <property name="label">A</property>
                        <property name="wrap">true</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="repeat_two">
                    <property name="orientation">vertical</property>
                    <property name="spacing">0</property>
                    <style><class name="tw-3"/></style>
                    <child>
                      <object class="GtkLabel" id="node_6">
                        <property name="xalign">0.0</property>
                        <property name="label">B</property>
                        <property name="wrap">true</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="unstyled">
                    <property name="orientation">vertical</property>
                    <property name="spacing">0</property>
                    <child>
                      <object class="GtkLabel" id="node_8">
                        <property name="xalign">0.0</property>
                        <property name="label">No GTK CSS properties</property>
                        <property name="wrap">true</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
